// snow_patch25: Truck.qml - різдвяна фура з гірляндою (вектор, без бренду)
import QtQuick
import QtQuick.Shapes

Item {
    id: tr

    property real layerWidth: 1920
    property real snowAmount: 20
    property real speed: 130
    property real startX: 0
    property bool lite: false

    readonly property real bladeX: x + 3
    readonly property real load: Math.max(0, Math.min(1, (startX - x) / Math.max(1, layerWidth)))
    readonly property real heapW: 8 + load * (snowAmount * 1.8 + 24)
    readonly property real heapH: Math.min(40, 6 + load * (snowAmount * 0.9 + 10))
    readonly property bool running: visible

    // спільні фази анімацій
    property int tick: 0
    property real fx: 0
    property real eb: 0
    property real wv: 0
    property real bx: 0
    readonly property bool winkOn: lite ? (tick % 9 === 0) : (tick % 31 < 3)
    readonly property real glowK: 0.75 + 0.25 * Math.sin(tick * 0.3)
    // підстрибування: тягач і причеп трохи не в фазі
    readonly property real bumpA: Math.sin(x * 0.05) * 0.9 + Math.sin(x * 0.13 + 1.3) * 0.45 + (lite ? 0 : Math.sin(eb * 6.2832) * 0.25)
    readonly property real bumpB: Math.sin((x + 70) * 0.05) * 0.9 + Math.sin((x + 70) * 0.13 + 1.3) * 0.45

    readonly property var bulbs: buildBulbs()
    readonly property var cabBulbs: bulbs.filter(function (b) { return b.g === 0; })
    readonly property var trlBulbs: bulbs.filter(function (b) { return b.g === 1; })

    signal finished()

    width: 400
    height: 104
    visible: false

    function start(amount) {
        if (visible) return;
        snowAmount = amount;
        startX = layerWidth + 30;
        x = startX;
        visible = true;
        drive.from = startX;
        drive.to = -(width + 160);
        drive.duration = Math.round((drive.from - drive.to) / speed * 1000);
        drive.restart();
    }

    function abort() {
        drive.stop();
        visible = false;
    }

    // яскравість лампочки i: хвиля-chase + мерехтіння (у lite просто чергування)
    function litOf(i) {
        if (lite) return ((i + tick) % 2 === 0) ? 1.0 : 0.6;
        var d = (((tick * 2 - i) % 14) + 14) % 14;
        var v = 0.38 + 0.62 * Math.max(0, 1 - d / 6);
        if ((i * 7) % 5 === 0 && (tick + i) % 4 === 0) v *= 0.55;
        return v;
    }

    // точки гірлянди вздовж контуру: g=0 бампер і решітка (кабіна без гірлянди), g=1 причеп
    // n для причепа зсунуто на 21, щоб chase-хвиля причепа лишилась такою ж, як була
    function buildBulbs() {
        var a = [];
        function line(g, x0, y0, x1, y1, step) {
            var dx = x1 - x0;
            var dy = y1 - y0;
            var n = Math.max(1, Math.round(Math.sqrt(dx * dx + dy * dy) / step));
            for (var i = 0; i < n; i++)
                a.push({ g: g, n: a.length + (g === 1 ? 21 : 0), x: x0 + dx * i / n, y: y0 + dy * i / n });
        }
        function arc(g, cx, cy, r, a0, a1, cnt) {
            for (var i = 0; i < cnt; i++) {
                var th = (a0 + (a1 - a0) * i / Math.max(1, cnt - 1)) * Math.PI / 180;
                a.push({ g: g, n: a.length + (g === 1 ? 21 : 0), x: cx + r * Math.cos(th), y: cy - r * Math.sin(th) });
            }
        }
        // бампер і решітка
        line(0, 14, 91, 4, 91, 5);
        line(0, 2, 88, 2, 70, 6);
        line(0, 4, 66, 4, 48, 6);
        // причеп: передній край, дах, задній край, низ
        line(1, 160, 80, 160, 14, 11);
        line(1, 160, 10, 396, 10, 12);
        line(1, 396, 14, 396, 80, 11);
        line(1, 394, 89, 386, 89, 8);
        line(1, 318, 89, 166, 89, 12);
        // колісні арки причепа
        arc(1, 338, 92, 17, 20, 160, 5);
        arc(1, 364, 92, 17, 20, 160, 5);
        return a;
    }

    NumberAnimation {
        id: drive
        target: tr
        property: "x"
        easing.type: Easing.Linear
        onFinished: {
            tr.visible = false;
            tr.finished();
        }
    }

    // один спільний тік для гірлянди (у lite рідший)
    Timer {
        interval: tr.lite ? 320 : 110
        repeat: true
        running: tr.visible
        onTriggered: tr.tick = (tr.tick + 1) % 7812
    }

    NumberAnimation on fx {
        from: 0
        to: 1
        duration: 1100
        loops: Animation.Infinite
        running: tr.visible
    }

    // ритм двигуна: кожні 520 мс нова пухка з труби
    NumberAnimation on eb {
        from: 0
        to: 3
        duration: 1560
        loops: Animation.Infinite
        running: tr.visible && !tr.lite
    }

    NumberAnimation on wv {
        from: 0
        to: 1
        duration: 1000
        loops: Animation.Infinite
        running: tr.visible
    }

    NumberAnimation on bx {
        from: 0
        to: 1
        duration: 800
        loops: Animation.Infinite
        running: tr.visible && !tr.lite
    }

    // ---- малі компоненти (не бачать id зовнішнього файлу) ----

    component Wheel: Item {
        property real travel: 0
        width: 24
        height: 24
        rotation: travel / (width / 2) * 57.2958
        Rectangle {
            anchors.fill: parent
            radius: width / 2
            color: "#15171a"
        }
        Rectangle {
            anchors.centerIn: parent
            width: parent.width * 0.86
            height: width
            radius: width / 2
            color: "#272b31"
        }
        Rectangle {
            anchors.centerIn: parent
            width: parent.width * 0.6
            height: width
            radius: width / 2
            gradient: Gradient {
                GradientStop { position: 0.0; color: "#ffffff" }
                GradientStop { position: 0.5; color: "#a9b6bf" }
                GradientStop { position: 1.0; color: "#e9eef1" }
            }
        }
        Rectangle {
            anchors.centerIn: parent
            width: parent.width * 0.3
            height: width
            radius: width / 2
            color: "#5c6770"
        }
        Rectangle {
            anchors.centerIn: parent
            width: parent.width * 0.5
            height: 1
            color: "#7d8a93"
        }
        Rectangle {
            anchors.centerIn: parent
            width: 1
            height: parent.width * 0.5
            color: "#7d8a93"
        }
    }

    // лампочка гірлянди зі сяйвом (bloom); центр у (0,0)
    component Bulb: Item {
        property real lit: 1
        property real glowK: 1
        property bool soft: true
        property color col: "#ffd75a"
        width: 0
        height: 0
        Rectangle {
            visible: parent.soft
            x: -8
            y: -8
            width: 16
            height: 16
            radius: 8
            color: parent.col
            opacity: 0.3 * parent.lit * parent.glowK
        }
        Rectangle {
            x: -2.5
            y: -2.5
            width: 5
            height: 5
            radius: 2.5
            color: parent.col
            border.width: 1
            border.color: "#fff6cf"
            opacity: 0.4 + 0.6 * parent.lit
        }
    }

    // хромована деталь
    component Chrome: Rectangle {
        id: ch
        property bool hz: false
        gradient: Gradient {
            orientation: ch.hz ? Gradient.Horizontal : Gradient.Vertical
            GradientStop { position: 0.0; color: "#ffffff" }
            GradientStop { position: 0.3; color: "#cfd8dc" }
            GradientStop { position: 0.65; color: "#8fa1ab" }
            GradientStop { position: 1.0; color: "#e8eef2" }
        }
    }

    // плавна фігура з вертикальним градієнтом
    component Panel: Shape {
        id: pn
        property string d: ""
        property real gy1: 0
        property real gy2: 100
        property color c0: "#ef5350"
        property color c1: "#d32f2f"
        property color c2: "#b71c1c"
        preferredRendererType: Shape.CurveRenderer
        ShapePath {
            strokeColor: "transparent"
            fillGradient: LinearGradient {
                x1: 0
                y1: pn.gy1
                x2: 0
                y2: pn.gy2
                GradientStop { position: 0.0; color: pn.c0 }
                GradientStop { position: 0.4; color: pn.c1 }
                GradientStop { position: 1.0; color: pn.c2 }
            }
            PathSvg { path: pn.d }
        }
    }

    // плавна фігура однієї заливки (з необов'язковим контуром)
    component Flat: Shape {
        id: fl
        property string d: ""
        property color fill: "#ffffff"
        property color edge: "transparent"
        property real edgeW: 0
        preferredRendererType: Shape.CurveRenderer
        ShapePath {
            fillColor: fl.fill
            strokeColor: fl.edge
            strokeWidth: fl.edgeW > 0 ? fl.edgeW : -1
            PathSvg { path: fl.d }
        }
    }

    // ---- сцена ----

    // конус світла фар (вліво), гойдається на нерівностях; вимикається в lite
    Shape {
        visible: !tr.lite
        opacity: 0.8 + 0.2 * Math.sin(tr.fx * 6.2832)
        preferredRendererType: Shape.CurveRenderer
        transform: Rotation {
            origin.x: 6
            origin.y: 58
            angle: tr.bumpA * 1.6
        }
        ShapePath {
            strokeColor: "transparent"
            fillGradient: LinearGradient {
                x1: 4
                y1: 0
                x2: -110
                y2: 0
                GradientStop { position: 0.0; color: "#99ffe9a0" }
                GradientStop { position: 1.0; color: "#00ffe9a0" }
            }
            startX: 4
            startY: 56
            PathLine { x: -110; y: 30 }
            PathLine { x: -110; y: 101 }
            PathLine { x: 4; y: 61 }
        }
    }

    // купа снігу перед відвалом
    Rectangle {
        x: 6 - tr.heapW - 2
        y: tr.height - tr.heapH - 1
        width: tr.heapW + 2
        height: tr.heapH + 1
        color: "#d6e3f3"
        topLeftRadius: tr.heapH
        topRightRadius: tr.heapH * 0.45
    }
    Rectangle {
        x: 6 - tr.heapW
        y: tr.height - tr.heapH
        width: tr.heapW
        height: tr.heapH
        color: "#ffffff"
        topLeftRadius: tr.heapH
        topRightRadius: tr.heapH * 0.45
    }

    // сніговий пил: 4 сніжинки підлітають і падають
    Repeater {
        model: 4
        Rectangle {
            required property int index
            readonly property real u: (tr.fx + index * 0.27) % 1
            width: 3
            height: 3
            radius: 1.5
            color: "#ffffff"
            x: 6 - tr.heapW * (0.15 + 0.2 * index) - u * 10
            y: tr.height - tr.heapH - 3 - Math.sin(Math.PI * u) * (9 + (index % 2) * 6)
            opacity: 1 - u * u * 0.9
        }
    }

    // тінь під фурою
    Rectangle {
        x: 4
        y: tr.height - 3
        width: tr.width - 8
        height: 5
        radius: 2.5
        color: "#000000"
        opacity: 0.22
    }

    // шасі
    Rectangle { x: 8; y: 86; width: 358; height: 5; color: "#2b2f36" }

    // ---------------- причеп ----------------
    Item {
        y: tr.bumpB

        Panel {
            d: "M162,10 L394,10 Q398,10 398,14 L398,80 L158,80 L158,14 Q158,10 162,10 Z"
            gy1: 10
            gy2: 80
        }
        Flat { d: "M162,13 L394,13 L394,18 L162,18 Z"; fill: "#30ffffff" }
        Flat { d: "M158,66 L398,66 L398,76 L158,76 Z"; fill: "#18000000" }
        Repeater {
            model: [198, 238, 318, 358]
            Rectangle {
                required property var modelData
                x: modelData
                y: 14
                width: 1
                height: 62
                color: "#26000000"
            }
        }
        Rectangle { x: 388; y: 12; width: 1; height: 66; color: "#33000000" }
        Rectangle { x: 158; y: 76; width: 240; height: 4; color: "#8e1b1b" }

        // нижня спідниця (темно-сіра)
        Rectangle {
            x: 160
            y: 80
            width: 236
            height: 10
            radius: 2
            gradient: Gradient {
                GradientStop { position: 0.0; color: "#5b636d" }
                GradientStop { position: 1.0; color: "#2f353c" }
            }
        }
        // ніша під тандем
        Flat { d: "M320,90 L320,84 C320,77 325,74 332,74 L370,74 C377,74 382,77 382,84 L382,90 Z"; fill: "#14171a" }
        // опорні стійки, бризковик
        Rectangle { x: 178; y: 90; width: 3; height: 12; color: "#455a64" }
        Rectangle { x: 174; y: 101; width: 11; height: 2; color: "#37474f" }
        Rectangle { x: 383; y: 84; width: 3; height: 16; radius: 1; color: "#1b1e22" }
        // задній розкидач солі, бампер, ліхтарі
        Rectangle { x: 396; y: 70; width: 5; height: 18; radius: 1; color: "#607d8b" }
        Rectangle { x: 398; y: 86; width: 8; height: 4; radius: 2; color: "#37474f" }
        Rectangle { x: 390; y: 90; width: 8; height: 3; color: "#1f2328" }
        Rectangle { x: 394; y: 64; width: 4; height: 5; radius: 1.5; color: "#ff3b3b" }
        Rectangle { x: 394; y: 71; width: 4; height: 5; radius: 1.5; color: "#ff3b3b" }

        // зелене коло із Сантою
        Rectangle {
            x: 252
            y: 20
            width: 52
            height: 52
            radius: 26
            color: "transparent"
            border.width: 1
            border.color: "#66ffffff"
        }
        Rectangle {
            x: 254
            y: 22
            width: 48
            height: 48
            radius: 24
            border.width: 2
            border.color: "#f5f5f5"
            gradient: Gradient {
                GradientStop { position: 0.0; color: "#43a047" }
                GradientStop { position: 1.0; color: "#1b5e20" }
            }
        }
        Item {
            x: 254
            y: 22
            width: 48
            height: 48

            // шуба
            Flat {
                d: "M10,31 Q10,28 14,28 L34,28 Q38,28 38,31 L40,38 L36,42.5 L12,42.5 L8,38 Z"
                fill: "#c62828"
            }
            Rectangle { x: 22.5; y: 30; width: 3; height: 12.5; color: "#ffffff" }

            // рука, що махає (хитається навколо плеча)
            Item {
                x: 33
                y: 25
                width: 6
                height: 12
                transformOrigin: Item.Bottom
                rotation: 20 + Math.sin(tr.wv * 6.2832) * 20
                Rectangle { anchors.fill: parent; radius: 3; color: "#c62828" }
                Rectangle { x: -0.5; y: -3; width: 7; height: 7; radius: 3.5; color: "#ffffff" }
            }

            // голова, борода, обличчя
            Rectangle { x: 17; y: 15; width: 14; height: 14; radius: 7; color: "#f4c9a0" }
            Rectangle { x: 16; y: 22; width: 16; height: 13; radius: 6; color: "#ffffff" }
            Rectangle { x: 22.5; y: 22; width: 3; height: 3; radius: 1.5; color: "#e8a07a" }
            Rectangle { x: 22.5; y: 26.5; width: 3; height: 1.5; radius: 0.75; color: "#c2655a" }
            // очі: ліве підморгує
            Rectangle {
                x: 20.5
                y: tr.winkOn ? 20.5 : 19.5
                width: tr.winkOn ? 3 : 2
                height: tr.winkOn ? 1 : 2
                radius: 1
                color: "#37262a"
            }
            Rectangle { x: 26.5; y: 19.5; width: 2; height: 2; radius: 1; color: "#37262a" }

            // шапка
            Flat { d: "M16.5,17 C16.5,11 20,6.5 26,5.5 C30,5 34,8 36,13 L31.5,17 Z"; fill: "#d32f2f" }
            Rectangle { x: 15; y: 15.5; width: 18; height: 4; radius: 2; color: "#ffffff" }
            Rectangle { x: 33.5; y: 10.5; width: 5; height: 5; radius: 2.5; color: "#ffffff" }
        }
    }

    // ---------------- тягач ----------------
    Item {
        y: tr.bumpA

        // кабіна + спальник
        Panel {
            d: "M68,86 L68,46 C68,36 72,26 76,21 C78,18 81,17 85,17 L102,17 C106,17 109,22 113,24 L138,24 C141,24 143,26 143,30 L143,86 Z"
            gy1: 17
            gy2: 86
            c2: "#a31d1d"
        }
        Flat { d: "M85,19 L102,19 L102,21.5 L85,21.5 Z"; fill: "#40ffffff" }
        Flat { d: "M116,26 L138,26 L138,28.5 L116,28.5 Z"; fill: "#33ffffff" }
        Flat { d: "M79,47 L83,24 L104,24 L104,85 L79,85 Z"; fill: "transparent"; edge: "#7f1313"; edgeW: 1 }
        Rectangle { x: 97; y: 52; width: 6; height: 2; radius: 1; color: "#e8edf0" }
        Rectangle { x: 108; y: 28; width: 1; height: 58; color: "#8e1b1b" }
        Rectangle { x: 110; y: 70; width: 32; height: 2; color: "#cfd8dc"; opacity: 0.8 }
        Rectangle { x: 82; y: 86; width: 20; height: 2; color: "#cfd8dc" }

        // капот
        Panel {
            d: "M8,50 Q8,46 13,46 L68,44.5 L68,86 L8,86 Z"
            gy1: 44
            gy2: 86
        }
        Flat { d: "M16,49.5 L66,47.5 L66,51 L16,52.5 Z"; fill: "#38ffffff" }
        Rectangle { x: 14; y: 64; width: 54; height: 2; color: "#e3eaee"; opacity: 0.85 }

        // колісні арки
        Flat { d: "M19.2,86 A16,16 0 0 1 48.8,86 Z"; fill: "#14171a" }
        Flat { d: "M85.7,86 A15.5,15.5 0 0 1 114.3,86 Z"; fill: "#14171a" }
        Flat { d: "M111.7,86 A15.5,15.5 0 0 1 140.3,86 Z"; fill: "#14171a" }

        // скло: лобова смужка, бічне, спальник
        Panel {
            d: "M72,44 L75.5,28 C76,26.5 77,25.5 79,25 L83,26 L80,45 Z"
            gy1: 25
            gy2: 45
            c0: "#b6e3f7"
            c1: "#7fbcd9"
            c2: "#4f88a6"
        }
        Panel {
            d: "M80,45 L84,26 C84.5,24 86,23.5 88,23.5 L102,23.5 L102,45 Z"
            gy1: 23.5
            gy2: 45
            c0: "#d9f3ff"
            c1: "#9fd4ea"
            c2: "#5f9fc0"
        }
        // водій киває
        Item {
            y: Math.sin(tr.fx * 6.2832) * 1.1
            Rectangle { x: 90; y: 38; width: 12; height: 6; radius: 3; color: "#455a64" }
            Item {
                x: 96
                y: 38
                rotation: Math.sin(tr.fx * 6.2832 + 0.6) * 5
                Rectangle { x: -4; y: -9; width: 8; height: 9; radius: 4; color: "#f2c6a0" }
                Rectangle { x: -4.5; y: -11; width: 9; height: 5; radius: 2.5; color: "#c62828" }
                Rectangle { x: -1; y: -13; width: 3.5; height: 3.5; radius: 1.75; color: "#ffffff" }
                Rectangle { x: -3; y: -5; width: 1.5; height: 1.5; radius: 0.75; color: "#37262a" }
            }
        }
        Flat { d: "M90,24 L96,24 L88,44 L82,44 Z"; fill: "#33ffffff" }
        Flat { d: "M80,45 L84,26 C84.5,24 86,23.5 88,23.5 L102,23.5 L102,45 Z"; fill: "transparent"; edge: "#2f3b42"; edgeW: 1 }
        Rectangle {
            x: 118
            y: 33
            width: 18
            height: 11
            radius: 2
            border.width: 1
            border.color: "#2f3b42"
            gradient: Gradient {
                GradientStop { position: 0.0; color: "#d9f3ff" }
                GradientStop { position: 1.0; color: "#5f9fc0" }
            }
        }

        // дзеркало
        Rectangle { x: 68; y: 36; width: 11; height: 2; color: "#37474f" }
        Chrome { x: 63; y: 31; width: 6; height: 13; radius: 2.5; border.width: 1; border.color: "#455a64" }

        // решітка радіатора
        Chrome { x: 4; y: 46; width: 13; height: 38; radius: 3; border.width: 1; border.color: "#78909c" }
        Repeater {
            model: 8
            Rectangle {
                required property int index
                x: 6
                y: 50 + index * 4.4
                width: 9
                height: 1
                color: "#5a6b75"
            }
        }

        // фара: світиться і пульсує
        Rectangle {
            visible: !tr.lite
            x: -4
            y: 48
            width: 21
            height: 21
            radius: 10.5
            color: "#ffe27a"
            opacity: 0.28 + 0.14 * Math.sin(tr.fx * 6.2832)
        }
        Rectangle {
            x: 2
            y: 54
            width: 9
            height: 9
            radius: 4.5
            color: "#fff6c0"
            border.width: 1
            border.color: "#b0bec5"
        }

        // хромований бампер і малий відвал на x ~ 0
        Chrome { x: 2; y: 70; width: 13; height: 20; radius: 3; border.width: 1; border.color: "#78909c" }
        Panel {
            d: "M0,76 L6,74 L7,100 L1,101 L0,99 Z"
            gy1: 74
            gy2: 101
            c0: "#b0bec5"
            c1: "#78909c"
            c2: "#546e7a"
        }
        Rectangle { x: 0; y: 98; width: 7; height: 3; radius: 1; color: "#263238" }

        // дві високі хромовані труби за кабіною
        Chrome { hz: true; x: 146; y: 6; width: 4; height: 78 }
        Chrome { hz: true; x: 152; y: 6; width: 4; height: 78 }
        Rectangle { x: 145; y: 3; width: 6; height: 4; radius: 2; color: "#cfd8dc" }
        Rectangle { x: 151; y: 3; width: 6; height: 4; radius: 2; color: "#cfd8dc" }
        Rectangle { x: 145; y: 30; width: 6; height: 3; color: "#90a4ae" }
        Rectangle { x: 151; y: 30; width: 6; height: 3; color: "#90a4ae" }
        Rectangle { x: 145; y: 58; width: 6; height: 3; color: "#90a4ae" }
        Rectangle { x: 151; y: 58; width: 6; height: 3; color: "#90a4ae" }

        // маячок на даху (миготить і "обертається")
        Item {
            visible: !tr.lite
            Rectangle {
                readonly property real k: Math.abs(Math.cos(tr.bx * 6.2832))
                width: 4 + 26 * k
                height: 4
                x: 94 - width / 2
                y: 9
                radius: 2
                color: "#ffcc4d"
                opacity: 0.5 * k
            }
            Rectangle { x: 88; y: 14; width: 12; height: 3; radius: 1; color: "#263238" }
            Rectangle {
                x: 90
                y: 8
                width: 8
                height: 7
                radius: 3.5
                color: "#ffb300"
                opacity: 0.55 + 0.45 * Math.abs(Math.sin(tr.bx * 6.2832))
            }
        }

        // дим із двох труб у ритм двигуна
        Repeater {
            model: 6
            Rectangle {
                required property int index
                readonly property int st: index % 2
                readonly property real u: ((tr.eb + Math.floor(index / 2) + st * 0.5) % 3) / 3
                visible: !tr.lite
                width: 3 + u * 8
                height: width
                radius: width / 2
                x: (st === 0 ? 148 : 154) - width / 2 + u * 24
                y: 3 - u * 20 - height / 2
                color: "#cfd8dc"
                opacity: 0.55 * (1 - u)
            }
        }
    }

    // колеса: 1 під капотом, 2 під кабіною, 2 під причепом
    Wheel { x: 22; y: 80; travel: tr.x }
    Wheel { x: 88; y: 80; travel: tr.x }
    Wheel { x: 114; y: 80; travel: tr.x }
    Wheel { x: 326; y: 80; travel: tr.x }
    Wheel { x: 352; y: 80; travel: tr.x }

    // гірлянда тягача: тільки бампер і решітка (завжди над усім, рухається разом із кузовом)
    Item {
        y: tr.bumpA
        Repeater {
            model: tr.cabBulbs
            Bulb {
                required property var modelData
                x: modelData.x
                y: modelData.y
                lit: tr.litOf(modelData.n)
                glowK: tr.glowK
                soft: !tr.lite
                col: (modelData.n % 3 === 0) ? "#ffb830" : "#ffd75a"
            }
        }
    }

    // гірлянда причепа
    Item {
        y: tr.bumpB
        Repeater {
            model: tr.trlBulbs
            Bulb {
                required property var modelData
                x: modelData.x
                y: modelData.y
                lit: tr.litOf(modelData.n)
                glowK: tr.glowK
                soft: !tr.lite
                col: (modelData.n % 3 === 0) ? "#ffb830" : "#ffd75a"
            }
        }
    }

    // сіль із заднього розкидача
    Repeater {
        model: 7
        Rectangle {
            required property int index
            readonly property real u: (tr.fx * 2 + index / 7) % 1
            visible: !tr.lite
            width: 2
            height: 2
            radius: 1
            color: "#f1f5f9"
            x: 402 + u * 30 + (index % 3) * 3
            y: 86 - Math.sin(Math.PI * u) * 6 + u * u * 17
            opacity: 1 - u * 0.6
        }
    }
}
