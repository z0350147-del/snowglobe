import QtQuick
import Quickshell
import Quickshell.Wayland
import Quickshell.Io

PanelWindow {
    id: win

    property var world: null
    signal closeRequested()

    property int tab: 0
    property bool adv: false
    property real pop: 0
    readonly property var levelNames: ["Off", "Light", "Steady", "Heavy", "Variable"]
    property bool resetArmed: false
    readonly property var presets: ({
        cozy: { level: 1, windStrength: 0.1, windGust: false, accumulate: true, bottom: true, windowSnow: true, growSeconds: 120, bottomMax: 28, windowMax: 20 },
        storm: { level: 3, windStrength: 0.7, windGust: true, accumulate: true, bottom: true, windowSnow: true, growSeconds: 25, bottomMax: 80, windowMax: 40 },
        minimal: { level: 1, windStrength: 0, windGust: false, accumulate: false, bottom: false, windowSnow: false, saveMode: true }
    })
    readonly property var defaults: ({
        level: 2, accumulate: true, melt: false, bottom: true, bottomAuto: false, bottomOffset: 0, bottomMax: 36,
        windowSnow: true, windowMax: 26, growSeconds: 60, windStrength: 0, windGust: false, brushSize: 40,
        ballGrow: 1, ballMax: 48, luck: 0, snowmenOn: true, announce: true, tractorMode: 1,
        gameMode: true, saveMode: false, dance: true, vehicle: 3,
        interactive: true, vehicleOpacity: 0.85, vehicleScale: 0.55, snowOpacity: 1, accentIdx: 0
    })
    readonly property var found: {
        try { return JSON.parse(SnowConfig.foundJson) || ({}); } catch (e) { return ({}); }
    }
    readonly property int foundCount: {
        var n = 0;
        for (var i = 0; i < SnowTypes.list.length; i++)
            if ((found[i] || 0) > 0) n++;
        return n;
    }

    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "snowfall-settings"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
    anchors { top: true; right: true }
    margins { top: 56; right: 20 }
    implicitWidth: 360
    implicitHeight: Math.min(640, (win.screen ? win.screen.height : 800) - 90)

    onVisibleChanged: {
        if (visible) {
            pop = 0;
            popAnim.restart();
        }
    }

    NumberAnimation { id: popAnim; target: win; property: "pop"; to: 1; duration: 160; easing.type: Easing.OutCubic }

    CfgWriter { id: cfg }

    // записує кілька ключів у config.json одним разом (пресети, скидання)
    Process { id: batchProc }
    function applyBatch(obj) {
        var py = "import json,os,sys\n"
            + "p=os.path.expanduser('~/.config/snowfall/config.json')\n"
            + "try:\n d=json.load(open(p))\nexcept Exception:\n d={}\n"
            + "d.update(json.loads(sys.argv[1]))\n"
            + "os.makedirs(os.path.dirname(p),exist_ok=True)\n"
            + "json.dump(d,open(p,'w'),indent=2)\n";
        batchProc.command = ["python3", "-c", py, JSON.stringify(obj)];
        batchProc.running = false;
        batchProc.running = true;
    }
    Timer { id: resetTimer; interval: 3000; onTriggered: win.resetArmed = false }

    // ---------------- reusable pieces ----------------

    component SecTitle: Text {
        width: parent ? parent.width : 300
        topPadding: 8
        color: Qt.lighter(SnowConfig.accent, 1.05)
        font.pixelSize: 11
    }

    component Hint: Text {
        width: parent ? parent.width : 300
        wrapMode: Text.WordWrap
        color: "#8d949d"
        font.pixelSize: 11
        lineHeight: 1.2
    }

    component FToggle: Item {
        id: tg
        property string label: ""
        property string hint: ""
        property bool checked: false
        signal toggled(bool v)
        width: parent ? parent.width : 300
        height: hint !== "" ? 44 : 34

        Column {
            anchors.verticalCenter: parent.verticalCenter
            spacing: 1
            Text { text: tg.label; color: "#dfe2e6"; font.pixelSize: 13 }
            Text { visible: tg.hint !== ""; text: tg.hint; color: "#8d949d"; font.pixelSize: 11 }
        }

        Rectangle {
            width: 34
            height: 20
            radius: 10
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            color: tg.checked ? SnowConfig.accent : "#3a3f47"
            Behavior on color { ColorAnimation { duration: 140 } }
            Rectangle {
                width: 14
                height: 14
                radius: 7
                y: 3
                x: tg.checked ? 17 : 3
                color: tg.checked ? "#e8ecef" : "#8d949d"
                Behavior on x { NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
            }
        }

        MouseArea {
            anchors.fill: parent
            cursorShape: Qt.PointingHandCursor
            onClicked: tg.toggled(!tg.checked)
        }
    }

    component FSlider: Item {
        id: sl
        property string label: ""
        property real from: 0
        property real to: 1
        property real value: 0
        property real step: 0
        property int decimals: 0
        property string unit: ""
        property real dragV: 0
        property bool dragging: false
        readonly property real shown: (dragging || hold.running) ? dragV : value
        readonly property real t: Math.max(0, Math.min(1, (shown - from) / (to - from)))
        signal moved(real v)
        width: parent ? parent.width : 300
        height: 44

        Timer { id: hold; interval: 900 }

        Text { x: 0; y: 0; text: sl.label; color: "#dfe2e6"; font.pixelSize: 13 }
        Text {
            anchors.right: parent.right
            y: 1
            text: (sl.decimals > 0 ? sl.shown.toFixed(sl.decimals) : Math.round(sl.shown)) + sl.unit
            color: "#98a0aa"
            font.pixelSize: 12
        }

        Rectangle {
            id: trk
            x: 0
            y: 27
            width: parent.width
            height: 4
            radius: 2
            color: "#3a3f47"
            Rectangle {
                width: knob.x + 3
                height: parent.height
                radius: 2
                color: SnowConfig.accent
            }
        }

        Rectangle {
            id: knob
            width: 6
            height: 16
            radius: 3
            y: 21
            x: sl.t * (sl.width - 6)
            color: ma.pressed ? Qt.lighter(SnowConfig.accent, 1.3) : Qt.lighter(SnowConfig.accent, 1.15)
        }

        MouseArea {
            id: ma
            x: 0
            y: 14
            width: parent.width
            height: 30
            cursorShape: Qt.PointingHandCursor
            function upd(mx) {
                var tt = Math.max(0, Math.min(1, mx / width));
                var v = sl.from + tt * (sl.to - sl.from);
                if (sl.step > 0) v = Math.round(v / sl.step) * sl.step;
                sl.dragV = v;
                sl.moved(v);
            }
            onPressed: function(m) { sl.dragging = true; upd(m.x); }
            onPositionChanged: function(m) { if (ma.pressed) upd(m.x); }
            onReleased: { sl.dragging = false; hold.restart(); }
            onCanceled: { sl.dragging = false; hold.restart(); }
        }
    }

    component FPills: Item {
        id: pl
        property var options: []
        property int current: 0
        signal picked(int i)
        width: parent ? parent.width : 300
        height: 32

        Rectangle { anchors.fill: parent; radius: 8; color: "#2a2e34" }
        Rectangle {
            y: 3
            height: parent.height - 6
            radius: 6
            width: (parent.width - 6) / Math.max(1, pl.options.length)
            x: 3 + pl.current * width
            color: Qt.rgba(SnowConfig.accent.r, SnowConfig.accent.g, SnowConfig.accent.b, 0.28)
            border.width: 1
            border.color: SnowConfig.accent
            Behavior on x { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
        }
        Row {
            x: 3
            y: 3
            Repeater {
                model: pl.options
                Item {
                    width: (pl.width - 6) / Math.max(1, pl.options.length)
                    height: pl.height - 6
                    Text {
                        anchors.fill: parent
                        anchors.margins: 2
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                        fontSizeMode: Text.Fit
                        minimumPixelSize: 10
                        font.pixelSize: 12
                        text: modelData
                        color: index === pl.current ? "#e6eaee" : "#98a0aa"
                    }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: pl.picked(index)
                    }
                }
            }
        }
    }

    component FButton: Rectangle {
        id: bt
        property string label: ""
        signal clicked()
        height: 34
        radius: 8
        color: bma.pressed ? "#3b4550" : (bma.containsMouse ? "#343a41" : "#2a2e34")
        border.color: "#3a3f47"
        border.width: 1
        Behavior on color { ColorAnimation { duration: 100 } }
        Text {
            anchors.fill: parent
            anchors.margins: 4
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            fontSizeMode: Text.Fit
            minimumPixelSize: 10
            font.pixelSize: 12
            text: bt.label
            color: "#dfe2e6"
        }
        MouseArea {
            id: bma
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: bt.clicked()
        }
    }

    component TypeCard: Rectangle {
        id: card
        property int tid: 0
        property int count: 0
        readonly property var tp: SnowTypes.list[tid]
        readonly property color rc: SnowTypes.tiers[tp.tier].color
        readonly property bool known: count > 0
        signal summon(int tid)
        width: 158
        height: 160
        radius: 12
        color: (cma.containsMouse && known) ? "#30353c" : "#2a2e34"
        border.width: 1
        border.color: known ? Qt.rgba(rc.r, rc.g, rc.b, 0.7) : "#3a3f47"
        Behavior on color { ColorAnimation { duration: 120 } }

        Rectangle { x: 14; y: 1; width: parent.width - 28; height: 3; radius: 2; color: card.known ? card.rc : "#3a3f47" }

        Item {
            id: stage
            x: 1
            y: 8
            width: parent.width - 2
            height: 90
            clip: true
            Snowman {
                preview: true
                typeId: card.tid
                d1: 34
                d2: 22
                cx: stage.width / 2
                baseY: stage.height - 6
            }
        }

        Rectangle {
            x: 1
            y: 8
            width: parent.width - 2
            height: 90
            radius: 10
            color: "#1f2226"
            opacity: card.known ? 0 : 0.92
            visible: opacity > 0.01
            Text { anchors.centerIn: parent; text: "?"; color: "#555b64"; font.pixelSize: 34; font.weight: Font.Bold }
        }

        Column {
            x: 14
            y: 102
            width: parent.width - 28
            spacing: 2
            Text {
                width: parent.width
                text: card.known ? card.tp.name : "???"
                color: card.known ? "#e2e5e9" : "#7b828c"
                font.pixelSize: 14
                font.weight: Font.DemiBold
                elide: Text.ElideRight
            }
            Row {
                spacing: 8
                Text { text: SnowTypes.tiers[card.tp.tier].name; color: card.rc; font.pixelSize: 11 }
                Text { text: card.tp.weight + "%"; color: "#98a0aa"; font.pixelSize: 11 }
            }
            Text {
                width: parent.width
                text: card.known ? ("знайдено ×" + card.count) : "ще не знайдено"
                color: "#8d949d"
                font.pixelSize: 10
                elide: Text.ElideRight
            }
        }

        MouseArea {
            id: cma
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: card.known ? Qt.PointingHandCursor : Qt.ArrowCursor
            onClicked: { if (card.known) card.summon(card.tid); }
        }
    }

    // ---------------- panel ----------------

    Rectangle {
        id: panel
        anchors.fill: parent
        radius: 14
        opacity: win.pop
        scale: 0.97 + 0.03 * win.pop
        transformOrigin: Item.TopRight
        gradient: Gradient {
            GradientStop { position: 0.0; color: "#1b2838" }
            GradientStop { position: 0.45; color: "#1b2027" }
            GradientStop { position: 1.0; color: "#16191e" }
        }
        border.width: 1
        border.color: Qt.rgba(SnowConfig.accent.r, SnowConfig.accent.g, SnowConfig.accent.b, 0.45)
        clip: true
        focus: true
        Keys.onEscapePressed: win.closeRequested()

        // header
        Item {
            id: header
            x: 0
            y: 0
            width: parent.width
            height: 50

            Text {
                id: flakeGlyph
                text: "❄"
                color: SnowConfig.accent
                font.pixelSize: 20
                x: 16
                anchors.verticalCenter: parent.verticalCenter
                RotationAnimation on rotation { from: 0; to: 360; duration: 30000; loops: Animation.Infinite; running: win.visible }
            }
            Column {
                x: 48
                anchors.verticalCenter: parent.verticalCenter
                spacing: 0
                Text { text: "Snowglobe"; color: "#e2e5e9"; font.pixelSize: 17; font.weight: Font.DemiBold }
                Text { text: "сніг, сніговики й різдвяна фура"; color: "#98a0aa"; font.pixelSize: 11 }
            }
            Rectangle {
                width: 26
                height: 26
                radius: 13
                anchors.right: parent.right
                anchors.rightMargin: 12
                anchors.verticalCenter: parent.verticalCenter
                color: closeMa.containsMouse ? "#3a3f47" : "transparent"
                Behavior on color { ColorAnimation { duration: 100 } }
                Text { anchors.centerIn: parent; text: "✕"; color: "#98a0aa"; font.pixelSize: 12 }
                MouseArea {
                    id: closeMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: win.closeRequested()
                }
            }
        }

        // quick actions
        Row {
            id: quick
            x: 14
            y: 54
            width: parent.width - 28
            spacing: 8
            FButton {
                width: (quick.width - 8) / 2
                label: "Прибрати сніг"
                onClicked: cfg.set("clearTick", SnowConfig.clearTick + 1)
            }
            FButton {
                width: (quick.width - 8) / 2
                label: "Виїзд"
                onClicked: cfg.set("tractorTick", SnowConfig.tractorTick + 1)
            }
        }

        // tabs
        Item {
            id: tabs
            x: 14
            y: 96
            width: parent.width - 28
            height: 32

            Rectangle { anchors.fill: parent; radius: 8; color: "#2a2e34" }
            Rectangle {
                y: 3
                height: parent.height - 6
                radius: 6
                width: (parent.width - 6) / 2
                x: 3 + win.tab * width
                color: Qt.rgba(SnowConfig.accent.r, SnowConfig.accent.g, SnowConfig.accent.b, 0.28)
                border.width: 1
                border.color: SnowConfig.accent
                Behavior on x { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
            }
            Row {
                x: 3
                y: 3
                Repeater {
                    model: ["Налаштування", "Колекція"]
                    Item {
                        width: (tabs.width - 6) / 2
                        height: tabs.height - 6
                        Text {
                            anchors.centerIn: parent
                            text: modelData
                            color: index === win.tab ? "#e6eaee" : "#98a0aa"
                            font.pixelSize: 12
                        }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: win.tab = index
                        }
                    }
                }
            }
        }

        // pages
        Item {
            id: pages
            x: 14
            y: 134
            width: parent.width - 28
            height: parent.height - 134 - 12

            // ===== page 1: snow =====
            Flickable {
                id: f1
                anchors.fill: parent
                visible: opacity > 0.01
                opacity: win.tab === 0 ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: 180 } }
                contentWidth: width
                contentHeight: c1.height + 16
                clip: true
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: c1
                    width: f1.width
                    spacing: 6

                    SecTitle { text: "Рівень снігу" }
                    FPills {
                        options: win.levelNames
                        current: SnowConfig.level
                        onPicked: function(i) { cfg.set("level", i); }
                    }
                    FSlider {
                        label: "Прозорість снігу"
                        from: 0.2
                        to: 1
                        step: 0.05
                        decimals: 2
                        value: SnowConfig.snowOpacity
                        onMoved: function(v) { cfg.set("snowOpacity", v); }
                    }

                    SecTitle { text: "Пресети" }
                    Row {
                        spacing: 8
                        FButton { width: (c1.width - 16) / 3; label: "Затишний"; onClicked: win.applyBatch(win.presets.cozy) }
                        FButton { width: (c1.width - 16) / 3; label: "Завірюха"; onClicked: win.applyBatch(win.presets.storm) }
                        FButton { width: (c1.width - 16) / 3; label: "Мінімум"; onClicked: win.applyBatch(win.presets.minimal) }
                    }

                    SecTitle { text: "Транспорт" }
                    FPills {
                        options: ["Трактор", "Вантажівка", "Сани", "Випадково"]
                        current: SnowConfig.vehicle
                        onPicked: function(i) { cfg.set("vehicle", i); }
                    }
                    FSlider {
                        label: "Прозорість техніки"
                        from: 0.2
                        to: 1
                        step: 0.05
                        decimals: 2
                        value: SnowConfig.vehicleOpacity
                        onMoved: function(v) { cfg.set("vehicleOpacity", v); }
                    }
                    FSlider {
                        label: "Розмір вантажівки"
                        from: 0.3
                        to: 1.2
                        step: 0.05
                        decimals: 2
                        value: SnowConfig.vehicleScale
                        onMoved: function(v) { cfg.set("vehicleScale", v); }
                    }
                    SecTitle { text: "Колір теми" }
                    Row {
                        spacing: 10
                        Repeater {
                            model: SnowConfig.palette
                            Rectangle {
                                required property int index
                                required property var modelData
                                width: 30
                                height: 30
                                radius: 15
                                color: modelData
                                border.width: SnowConfig.accentIdx === index ? 3 : 1
                                border.color: SnowConfig.accentIdx === index ? "#ffffff" : "#44ffffff"
                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: cfg.set("accentIdx", index)
                                }
                            }
                        }
                    }
                    SecTitle { text: "Режими" }
                    FToggle {
                        label: "Інтерактивні зони"
                        hint: "кульки, сніговики, змітання мишею"
                        checked: SnowConfig.interactive
                        onToggled: function(v) { cfg.set("interactive", v); }
                    }
                    FToggle {
                        label: "Танці під музику"
                        hint: "сніговики танцюють, коли грає музика"
                        checked: SnowConfig.dance
                        onToggled: function(v) { cfg.set("dance", v); }
                    }
                    FToggle {
                        label: "Режим ігор"
                        hint: "ховати сніг, коли гра або вікно на весь екран"
                        checked: SnowConfig.gameMode
                        onToggled: function(v) { cfg.set("gameMode", v); }
                    }

                    Item {
                        width: c1.width
                        height: 34
                        Rectangle {
                            anchors.fill: parent
                            radius: 8
                            color: advMa.containsMouse ? "#343a41" : "#2a2e34"
                            border.color: "#3a3f47"
                            border.width: 1
                            Behavior on color { ColorAnimation { duration: 100 } }
                        }
                        Text {
                            x: 12
                            anchors.verticalCenter: parent.verticalCenter
                            text: "Додатково"
                            color: "#dfe2e6"
                            font.pixelSize: 12
                        }
                        Text {
                            anchors.right: parent.right
                            anchors.rightMargin: 12
                            anchors.verticalCenter: parent.verticalCenter
                            text: win.adv ? "▲" : "▼"
                            color: "#98a0aa"
                            font.pixelSize: 10
                        }
                        MouseArea {
                            id: advMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: win.adv = !win.adv
                        }
                    }
                    Column {
                        id: advCol
                        width: c1.width
                        spacing: 6
                        visible: win.adv

                        SecTitle { text: "Вітер" }
                        FSlider {
                            label: "Напрямок і сила"
                            from: -1
                            to: 1
                            step: 0.05
                            decimals: 2
                            value: SnowConfig.windStrength
                            onMoved: function(v) { cfg.set("windStrength", v); }
                        }
                        FToggle {
                            label: "Пориви вітру"
                            hint: "сила вітру хитається сама"
                            checked: SnowConfig.windGust
                            onToggled: function(v) { cfg.set("windGust", v); }
                        }

                        SecTitle { text: "Накопичення" }
                        FToggle {
                            label: "Накопичення снігу"
                            hint: "головний вимикач сугробів"
                            checked: SnowConfig.accumulate
                            onToggled: function(v) { cfg.set("accumulate", v); }
                        }
                        FToggle {
                            label: "Сніг унизу екрана"
                            checked: SnowConfig.bottom
                            onToggled: function(v) { cfg.set("bottom", v); }
                        }
                        FToggle {
                            label: "Сніг на вікнах"
                            checked: SnowConfig.windowSnow
                            onToggled: function(v) { cfg.set("windowSnow", v); }
                        }
                        FSlider {
                            label: "Час росту сугробу"
                            from: 10
                            to: 180
                            step: 5
                            unit: " с"
                            value: SnowConfig.growSeconds
                            onMoved: function(v) { cfg.set("growSeconds", v); }
                        }
                        FSlider {
                            label: "Макс. сніг на вікнах"
                            from: 8
                            to: 90
                            step: 1
                            value: SnowConfig.windowMax
                            onMoved: function(v) { cfg.set("windowMax", v); }
                        }
                        FSlider {
                            label: "Макс. купа знизу"
                            from: 20
                            to: 400
                            step: 5
                            value: SnowConfig.bottomMax
                            onMoved: function(v) { cfg.set("bottomMax", v); }
                        }
                        SecTitle { text: "Сніговики" }
                        FToggle {
                            label: "Складати сніговиків"
                            hint: "постав меншу кульку на більшу"
                            checked: SnowConfig.snowmenOn
                            onToggled: function(v) { cfg.set("snowmenOn", v); }
                        }
                        FToggle {
                            label: "Оголошувати рідкісних"
                            hint: "банер і конфеті при появі"
                            checked: SnowConfig.announce
                            onToggled: function(v) { cfg.set("announce", v); }
                        }

                        SecTitle { text: "Кульки та змітання" }
                        FSlider {
                            label: "Швидкість росту кульки"
                            from: 0.3
                            to: 3
                            step: 0.1
                            decimals: 1
                            value: SnowConfig.ballGrow
                            onMoved: function(v) { cfg.set("ballGrow", v); }
                        }
                        FSlider {
                            label: "Макс. розмір кульки"
                            from: 24
                            to: 90
                            step: 2
                            unit: " px"
                            value: SnowConfig.ballMax
                            onMoved: function(v) { cfg.set("ballMax", v); }
                        }
                        FSlider {
                            label: "Ширина змітання"
                            from: 16
                            to: 90
                            step: 2
                            unit: " px"
                            value: SnowConfig.brushSize
                            onMoved: function(v) { cfg.set("brushSize", v); }
                        }

                        SecTitle { text: "Реакція сніговиків" }
                        FPills {
                            options: ["Зносить усіх", "Рідкісні стрибають", "Усі стрибають"]
                            current: SnowConfig.tractorMode
                            onPicked: function(i) { cfg.set("tractorMode", i); }
                        }
                        Hint { text: "Що буде зі сніговиками й кульками, коли їде техніка. Звичайні розсипаються, а в режимі «Рідкісні стрибають» рідкісні й вище перестрибують лезо." }

                        SecTitle { text: "Продуктивність" }
                        FToggle {
                            label: "Економія ресурсів"
                            hint: "менше сніжинок і ефектів, рідші оновлення"
                            checked: SnowConfig.saveMode
                            onToggled: function(v) { cfg.set("saveMode", v); }
                        }

                        SecTitle { text: "Дії" }
                        Row {
                            spacing: 10
                            FButton {
                                width: (c1.width - 10) / 2
                                label: "Розтопити сніговиків"
                                onClicked: { if (win.world) win.world.meltSnowmen(); }
                            }
                            FButton {
                                width: (c1.width - 10) / 2
                                label: "Розсипати кульки"
                                onClicked: { if (win.world) win.world.popBalls(); }
                            }
                        }

                        SecTitle { text: "Скидання" }
                        FButton {
                            width: c1.width
                            label: win.resetArmed ? "Точно скинути? Натисни ще раз" : "Скинути налаштування"
                            onClicked: {
                                if (win.resetArmed) {
                                    win.resetArmed = false;
                                    resetTimer.stop();
                                    win.applyBatch(win.defaults);
                                } else {
                                    win.resetArmed = true;
                                    resetTimer.restart();
                                }
                            }
                        }
                        Hint { text: "Повертає значення за замовчуванням. Колекція сніговиків не чіпається." }

                        SecTitle { text: "Як користуватись" }
                        Hint { text: "• Води курсором по замету на вікні — змітаєш сніг." }
                        Hint { text: "• Права кнопка на снігу (вікно або низ екрана) — ліпиш кульку. Тримай, щоб росла." }
                        Hint { text: "• Постав меншу кульку на більшу — вийде сніговик, а який саме, вирішує випадок." }
                        Hint { text: "• Лівою кнопкою можна взяти сніговика й перенести куди завгодно." }
                    }
                }
            }

            // ===== page 3: collection =====
            Flickable {
                id: f3
                anchors.fill: parent
                visible: opacity > 0.01
                opacity: win.tab === 1 ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: 180 } }
                contentWidth: width
                contentHeight: c3.height + 16
                clip: true
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: c3
                    width: f3.width
                    spacing: 12

                    Item {
                        width: parent.width
                        height: 50
                        Text { x: 0; y: 0; text: "Колекція сніговиків"; color: "#e2e5e9"; font.pixelSize: 15; font.weight: Font.DemiBold }
                        Text {
                            anchors.right: parent.right
                            y: 0
                            text: win.foundCount + " / " + SnowTypes.list.length
                            color: "#9bb3c4"
                            font.pixelSize: 14
                            font.weight: Font.DemiBold
                        }
                        Rectangle {
                            y: 30
                            width: parent.width
                            height: 8
                            radius: 4
                            color: "#3a3f47"
                            Rectangle {
                                width: parent.width * win.foundCount / SnowTypes.list.length
                                height: parent.height
                                radius: 4
                                color: "#9bb3c4"
                                Behavior on width { NumberAnimation { duration: 320; easing.type: Easing.OutCubic } }
                            }
                        }
                    }

                    Hint { text: "Натисни на відкриту картку, щоб викликати цього сніговика." }
                    Grid {
                        columns: 2
                        spacing: 12
                        Repeater {
                            model: SnowTypes.list.length
                            TypeCard {
                                tid: index
                                count: win.found[index] || 0
                                onSummon: function(t) { if (win.world) win.world.spawnType(t); }
                            }
                        }
                    }
                }
            }
        }
    }
}
